  },

  ach(d) {
    return `<div class="ph rv"><h2>Prestasi</h2></div><div class="grid">${A(d.achievements).map((x, i) => `<div class="card glass rv" style="--i:${i}"><h3>${E(x.group)}</h3><ul class="ach">${A(x.items).map((t) => `<li>${E(t)}</li>`).join("")}</ul></div>`).join("")}</div>`;
  },

  gal(d) {
    return `<div class="ph rv"><h2>Galeri</h2><p>Dokumentasi kegiatan dan perjalanan.</p></div><div class="gal">${A(d.gallery).map((x, i) => `<figure class="glass rv" style="--i:${Math.min(i, 8)}" data-i="${i}" tabindex="0" role="button" aria-label="Buka foto ${i + 1}">${img(x.src, x.caption)}${x.caption ? `<figcaption>${E(x.caption)}</figcaption>` : ""}</figure>`).join("")}</div>`;
  },

  contact(d) {
    const c = d.contact || {};
    const w = String(c.whatsapp || "").replace(/\D/g, "");
    const ig = String(c.instagram || "").replace("@", "");
    const L = [
      [c.whatsapp && "wa", "WhatsApp", c.whatsapp, `https://wa.me/${w}`],
      [c.email && "contact", "Email", c.email, `mailto:${c.email}`],
      [c.instagram && "ig", "Instagram", c.instagram, `https://instagram.com/${ig}`],
      [c.address && "pin", "Alamat", c.address, `https://www.google.com/maps/search/${encodeURIComponent(c.address || "")}`],
    ].filter((x) => x[0]);
    return `<div class="ph rv"><h2>Kontak</h2><p>Terbuka untuk kolaborasi dan peluang baru.</p></div><div class="grid">${L.map((x, i) => `<a class="ct glass rv" style="--i:${i}" href="${E(x[3])}" target="_blank" rel="noopener">${svg(x[0])}<div><b>${x[1]}</b><span>${E(x[2])}</span></div></a>`).join("")}</div>`;
  },
};


/* ==========================================================================
   5. ROUTER + HISTORY (BACK BUTTON)
   --------------------------------------------------------------------------
   Masalah lama: navigasi pakai history.replaceState().
   replaceState hanya MENGGANTI URL di entri history yang sama,
   tidak menambah entri baru. Jadi:
     https://web.com/  -> klik About -> https://web.com/#about
   tetap 1 entri. Tombol Back pun langsung keluar web.

   Perbaikan: navigasi klik pakai history.pushState().
   pushState MENAMBAH entri baru, jadi:
     https://web.com/  -> klik About -> https://web.com/#about (entri ke-2)
     Back -> kembali ke https://web.com/ (entri ke-1)
     Back lagi -> baru keluar web (sudah benar).

   Aturan URL:
   - home  -> https://web.com/ (tanpa hash, bersih)
   - lain  -> https://web.com/#about, /#exp, dst.
   - Klik halaman yang sama tidak menambah entri duplikat.
   - Hash bukan halaman (mis. #main dari skip link) diabaikan router.
   - Tanpa Python / tanpa library. Murni History API bawaan browser.
   ========================================================================== */

/* URL untuk sebuah halaman. Home tanpa hash, sisanya pakai #id. */
function urlForPage(id) {
  const base = location.pathname + location.search;
  return id === "home" ? base : base + "#" + id;
}

/* Pindah halaman.
   noHistory = true  -> jangan sentuh history (dipakai saat back/forward & load awal).
   noHistory = false -> navigasi klik, tambah entri baru via pushState. */
function go(id, noHistory = false) {
  const target = $("#p-" + id) || $("#p-home");
  const nextId = target.id.slice(2);

  /* Sudah di halaman itu & sudah tampil: jangan buat entri duplikat.
     Tetap render ulang agar animasi jalan seperti sebelumnya. */
  const alreadyOnPage = nextId === cur && document.querySelector(".page.on");

  if (!noHistory && !alreadyOnPage) {
    try {
      history.pushState({ page: nextId }, "", urlForPage(nextId));
    } catch (err) {
      /* Fallback browser jadul: ubah hash, hashchange akan menangani render-nya. */
      location.hash = nextId === "home" ? "" : nextId;
    }
  }

  cur = nextId;

  /* Tampilkan halaman */
  $$(".page").forEach((p) => p.classList.remove("on"));
  target.innerHTML = R[nextId](DB);
  target.classList.add("on");

  /* Tandai menu yang aktif */
  $$("[data-go]").forEach((b) => {
    if (b.closest("nav, #fm")) b.setAttribute("aria-current", b.dataset.go === nextId ? "page" : "false");
  });

  /* Tandai FAB jika halaman aktif ada di menu "lainnya" */
  if (MORE.includes(nextId)) $("#fab").setAttribute("data-act", "");
  else $("#fab").removeAttribute("data-act");

  window.scrollTo({ top: 0, behavior: "instant" });
  init(nextId, target);
}

let routerReady = false;

/* Pasang listener history sekali saja (build bisa dipanggil ulang). */
function setupRouter() {
  if (routerReady) return;
  routerReady = true;

  /* BACK / FORWARD — tombol kembali browser & HP.
     popstate = sumber utama untuk navigasi yang dibuat via pushState. */
  window.addEventListener("popstate", (e) => {
    const statePage = e.state && e.state.page;
    const hashPage = location.hash.slice(1);

    let next = null;
    if (statePage && isPage(statePage)) next = statePage;
    else if (!location.hash) next = "home";
    else if (isPage(hashPage)) next = hashPage;
    else return; /* Hash bukan halaman (mis. #main) -> abaikan. */

    go(next, true);
  });

  /* Hashchange = cadangan untuk hash yang diketik manual / bookmark / link lama.
     Saat Back ditekan, popstate sudah jalan duluan, jadi cek cur di sini
     agar tidak render 2x. */
  window.addEventListener("hashchange", () => {
    const h = location.hash.slice(1);
    if (!h) {
      if (cur !== "home") go("home", true);
      return;
    }
    if (!isPage(h)) return; /* #main dll -> abaikan. */
    if (h === cur) return; /* Sudah ditangani popstate. */
    go(h, true);
  });
}


/* ==========================================================================
   6. BUILD — bangun nav, halaman, lalu tampilkan halaman awal
   ========================================================================== */
function build(d) {
  DB = d;
  const s = d.site || {};

  document.title = [s.name, A(s.roles)[0]].filter(Boolean).join(" | ");
  document.querySelector("meta[name=description]").content = s.tagline || "";

  const ld = document.createElement("script");
  ld.type = "application/ld+json";
  ld.textContent = JSON.stringify({ "@context": "https://schema.org", "@type": "Person", name: s.name, jobTitle: A(s.roles)[0], email: d.contact?.email, telephone: d.contact?.whatsapp, image: d.photos?.main });
  document.head.append(ld);

  const pg = PAGES.filter((p) => p[2](d));

  $("#nav").innerHTML = pg.map((p, i) => `<button data-go="${p[0]}" class="${i > 2 ? "ov" : ""}">${svg(p[0])}${p[1]}</button>`).join("");

  const mo = pg.slice(3);
  MORE = mo.map((p) => p[0]);
  $("#fm").innerHTML = mo.map((p, i) => `<button class="glass" role="menuitem" data-go="${p[0]}" style="--i:${i};--n:${mo.length}">${svg(p[0])}${p[1]}</button>`).join("");
  $("#fabw").style.display = mo.length ? "" : "";

  $("#main").innerHTML = pg.map((p) => `<section class="page" id="p-${p[0]}" aria-label="${p[1]}"></section>`).join("") + `<footer>© ${new Date().getFullYear()} ${E(s.name)}</footer>`;

  /* Router */
  setupRouter();

  /* Halaman awal dari URL. Hash kosong / #home = home (URL bersih tanpa hash). */
  const rawHash = location.hash.slice(1);
  const initial = isPage(rawHash) ? rawHash : "home";

  /* Beri state pada entri history PERTAMA, agar Back dari halaman ke-2
     bisa kembali ke halaman pertama (bukan langsung keluar web).
     replaceState = tidak menambah entri baru, hanya melengkapi entri yang ada.
     Jika awalnya #home, URL dinormalisasi jadi tanpa hash. */
  try {
    history.replaceState({ page: initial }, "", urlForPage(initial));
  } catch (err) { /* Abaikan, tetap render. */ }

  go(initial, true);
  $("#ld").classList.add("h");
}


/* ==========================================================================
   7. INIT per HALAMAN — slider, filter, galeri
   ========================================================================== */
function init(id, t) {
  /* Animasi bar bahasa */
  $$(".bar i", t).forEach((i) => requestAnimationFrame(() => (i.style.width = i.dataset.w + "%")));

  /* HOME: slider foto + rotasi role */
  if (id === "home") {
    const im = $$(".sl img", t);
    const ds = $$(".dots button", t);
    const sl = $("#sl");
    let k = 0;

    const show = (n) => {
      k = (n + im.length) % im.length;
      im.forEach((x, i) => x.classList.toggle("on", i === k));
      ds.forEach((x, i) => x.classList.toggle("on", i === k));
    };

    ds.forEach((b, i) => (b.onclick = () => show(i)));

    if (im.length > 1 && sl) {
      let hov = 0;
      timers.push(setInterval(() => !hov && show(k + 1), 4500));
      sl.onmouseenter = () => (hov = 1);
      sl.onmouseleave = () => (hov = 0);

      let x0 = null;
      sl.onpointerdown = (e) => (x0 = e.clientX);
      sl.onpointerup = (e) => {
        if (x0 !== null && Math.abs(e.clientX - x0) > 40) show(k + (e.clientX < x0 ? 1 : -1));
        x0 = null;
      };
    }

    if (sl && matchMedia("(hover:hover)").matches) {
      sl.onmousemove = (e) => {
        const r = sl.getBoundingClientRect();
        sl.style.transform = `perspective(900px) rotateY(${((e.clientX - r.left) / r.width - 0.5) * 8}deg) rotateX(${ -((e.clientY - r.top) / r.height - 0.5) * 8}deg)`;
      };
      sl.addEventListener("mouseleave", () => (sl.style.transform = ""));
    }

    const ro = A(DB.site?.roles);
    const rl = $("#rl");
    if (ro.length > 1 && rl) {
      let n = 0;
      timers.push(
        setInterval(() => {
          rl.classList.add("o");
          setTimeout(() => {
            rl.textContent = ro[++n % ro.length];
            rl.classList.remove("o");
          }, 400);
        }, 3000)
      );
    }
  }

  /* EXP: filter kategori */
  if (id === "exp") {
    $$(".fil button", t).forEach((b) => {
      b.onclick = () => {
        $$(".fil button", t).forEach((x) => x.setAttribute("aria-pressed", x === b));
        $$(".gp", t).forEach((p) => {
          p.hidden = p.dataset.g !== b.dataset.f;
          if (!p.hidden) {
            $$(".rv", p).forEach((e) => {
              e.style.animation = "none";
              void e.offsetWidth;
              e.style.animation = "";
            });
          }
        });
      };
    });
  }

  /* GAL: klik / Enter untuk buka lightbox */
  if (id === "gal") {
    $$("figure", t).forEach((f) => {
      f.onclick = () => lb(+f.dataset.i);
      f.onkeydown = (e) => (e.key === "Enter" || e.key === " ") && (e.preventDefault(), lb(+f.dataset.i));
    });
  }
}


/* ==========================================================================
   8. LIGHTBOX GALERI
   ========================================================================== */
let li = 0;
const LB = $("#lb");

function lb(n) {
  const g = A(DB.gallery);
  li = (n + g.length) % g.length;
  $("img", LB).src = g[li].src;
  $("img", LB).referrerPolicy = "no-referrer";
  $("p", LB).textContent = g[li].caption || "";
  LB.classList.add("on");
  document.body.style.overflow = "hidden";
}

const closeLB = () => {
  LB.classList.remove("on");
  document.body.style.overflow = "";
};

$(".x", LB).onclick = closeLB;
$(".pv", LB).onclick = () => lb(li - 1);
$(".nx", LB).onclick = () => lb(li + 1);
LB.onclick = (e) => e.target === LB && closeLB();

addEventListener("keydown", (e) => {
  if (!LB.classList.contains("on")) return;
  if (e.key === "Escape") closeLB();
  else if (e.key === "ArrowLeft") lb(li - 1);
  else if (e.key === "ArrowRight") lb(li + 1);
});

let sx = null;
LB.ontouchstart = (e) => (sx = e.touches[0].clientX);
LB.ontouchend = (e) => {
  if (sx !== null && Math.abs(e.changedTouches[0].clientX - sx) > 50) lb(li + (e.changedTouches[0].clientX < sx ? 1 : -1));
  sx = null;
};


/* ==========================================================================
   9. MENU FAB (mobile — menu "lainnya")
   ========================================================================== */
const fw = $("#fabw");
const fb = $("#fab");
const fo = (v) => {
  fw.classList.toggle("open", v);
  fb.setAttribute("aria-expanded", v);
};
fb.onclick = () => fo(!fw.classList.contains("open"));
$("#sc").onclick = () => fo(0);


/* ==========================================================================
  10. NAVIGASI GLOBAL
  --------------------------------------------------------------------------
  Semua tombol [data-go] lewat sini. go() tanpa argumen ke-2 = pushState,
  jadi setiap klik menambah entri history (Back bisa kembali selangkah).
  ========================================================================== */
document.addEventListener("click", (e) => {
  const b = e.target.closest("[data-go]");
  if (b) {
    go(b.dataset.go);
    fo(0);
  }
});
addEventListener("keydown", (e) => e.key === "Escape" && fo(0));


/* ==========================================================================
  11. ERROR & FILE PICKER (fallback manual)
  ========================================================================== */
function fail() {
  $("#ld").classList.add("h");
  $("#err").style.display = "block";
}

$("#fp").onchange = (e) => {
  const f = e.target.files[0];
  if (!f) return;
  f.text().then((t) => {
    try {
      $("#err").style.display = "none";
      build(JSON.parse(t));
    } catch (err) {
      fail();
    }
  });
};


/* ==========================================================================
  12. LOAD DATA dari JSONBin
  --------------------------------------------------------------------------
  - Sumber utama: JSONBin (JSONBIN_URL + JSONBIN_KEY di atas).
  - JSONBin v3 membalas { record: {...}, metadata: {...} },
    jadi data CV diambil dari json.record (fallback ke json langsung).
  - Mode ?preview tetap dari localStorage seperti sebelumnya.
  - Jika JSONBin gagal -> tampilkan panel error + file picker.
  ========================================================================== */
async function loadData() {
  try {
    if (new URLSearchParams(location.search).has("preview")) {
      const saved = localStorage.getItem("cv_db_preview");
      if (saved) return build(JSON.parse(saved));
    }

    const res = await fetch(JSONBIN_URL, {
      method: "GET",
      headers: {
        Accept: "application/json",
        "X-Master-Key": JSONBIN_KEY,
        "X-Access-Key": JSONBIN_KEY,
      },
      cache: "no-store",
    });
    if (!res.ok) throw new Error("JSONBin gagal: " + res.status);

    const json = await res.json();
    const data = json.record ?? json;
    if (!data || typeof data !== "object") throw new Error("Isi JSONBin bukan objek");

    build(data);
  } catch (err) {
    fail();
  }
}
loadData();

</script>
