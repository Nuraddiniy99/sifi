  ["contact", "Kontak", (d) => d.contact],
];
const PAGE_IDS = PAGES.map((p) => p[0]);
const isPage = (id) => PAGE_IDS.includes(id);


/* ==========================================================================
   4. RENDER (R) — HTML tiap halaman, dari data JSONBin
   ========================================================================== */
const R = {
  home(d) {
    const s = d.site || {};
    const p = d.photos || {};
    const ph = [p.main, ...A(p.slides)].filter(Boolean);
    const c = d.contact || {};
    const sk = A(d.skills).flatMap((x) => A(x.items));
    return `<section class="hero"><div><div class="role glass rv" style="--i:0" aria-live="polite"><span id="rl">${E(A(s.roles)[0] || "")}</span></div>
      <h1 class="rv" style="--i:1">${E(s.name)}</h1><p class="sum rv" style="--i:2">${E(A(d.profile?.summary)[0])}</p>
