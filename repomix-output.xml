  },

  exp(d) {
    const g = A(d.experience);
    const L = (i) => String.fromCharCode(65 + i);
    return `<div class="ph rv"><h2>Pengalaman Profesional</h2><p>Pilih kategori untuk melihat rinciannya.</p></div><div class="fil rv" style="--i:1" role="tablist">${g.map((x, i) => `<button role="tab" aria-pressed="${!i}" data-f="${i}">${L(i)}. ${E(x.group)}</button>`).join("")}</div>
