      ${A(d.languages).length ? `<div class="card glass rv" style="--i:3"><h3>Kemampuan Bahasa</h3><dl>${d.languages.map((x) => `<div><dt>${E(x.name)}</dt><dd>${E(x.level)}</dd><div class="bar"><i data-w="${E(x.percent || 80)}"></i></div></div>`).join("")}</dl></div>` : ""}</div>
